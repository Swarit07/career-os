# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — enables HLS video background on landing page
NEXT_PUBLIC_HERO_VIDEO_URL=

# Resume Forge — local LLM via Ollama (https://ollama.com)
# Defaults: base URL = http://localhost:11434/v1, model = llama3.2
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Phase 6 — Job Market (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
